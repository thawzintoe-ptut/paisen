<?xml version="1.0" encoding="utf-8"?>
<!--
  The ring p (icon C): a lowercase p drawn from a sky rounded-square ring, with a white dot in its
  counter. The background colour is the ink square.

  The paths sit in a 128-unit box, the 1024 iOS icon divided by 8, as in `BrandMark.kt`. The group
  maps that box onto the inner 72dp the launcher's mask can reach, so the 7-unit stroke lands as 3.9dp.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:scaleX="0.5625"
        android:scaleY="0.5625"
        android:translateX="18"
        android:translateY="18">

        <path
            android:pathData="M 57,32 H 71 A 14,14 0 0 1 85,46 V 60 A 14,14 0 0 1 71,74 H 57 A 14,14 0 0 1 43,60 V 46 A 14,14 0 0 1 57,32 Z"
            android:strokeColor="#A9DCF7"
            android:strokeWidth="7" />

        <path
            android:pathData="M 43,46 V 96"
            android:strokeColor="#A9DCF7"
            android:strokeLineCap="round"
            android:strokeWidth="7" />

        <path
            android:pathData="M 60.5,53 A 3.5,3.5 0 1 1 67.5,53 A 3.5,3.5 0 1 1 60.5,53 Z"
            android:fillColor="#FFFFFF" />
    </group>
</vector>
