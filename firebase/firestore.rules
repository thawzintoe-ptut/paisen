rules_version = '2';

// #188: shared groups. Your own spending never reaches this database; only groups, their member
// names and the shared expense log do. The log is append-only: entries are created, never changed.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function groupPath(gid) { return /databases/$(database)/documents/groups/$(gid); }
    function groupData(gid) { return get(groupPath(gid)).data; }
    function memberPath(gid, mid) { return /databases/$(database)/documents/groups/$(gid)/members/$(mid); }
    function isMember(gid) { return signedIn() && exists(groupPath(gid)) && request.auth.uid in groupData(gid).memberUids; }
    function isCreator(gid) { return signedIn() && exists(groupPath(gid)) && groupData(gid).creatorUid == request.auth.uid; }
    // A group the creator deleted for everyone takes nothing new.
    function live(gid) { return groupData(gid).get('deleted', false) != true; }
    function joinPath(gid) { return /databases/$(database)/documents/groups/$(gid)/joins/$(request.auth.uid); }
    // Join rights last only while the code someone came in with is still the group's live code.
    function joined(gid) { return signedIn() && exists(joinPath(gid)) && validInvite(gid, get(joinPath(gid)).data.code); }
    function joinedAfter(gid) { return signedIn() && existsAfter(joinPath(gid)) && validInvite(gid, getAfter(joinPath(gid)).data.code); }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function onlyChanged(keys) { return changed().hasOnly(keys); }
    function invitePath(code) { return /databases/$(database)/documents/invites/$(code); }
    // The group names its one live code, so an old invite left active can never let anyone in. An
    // invite made with an end date stops on it; one made before invites had one never does.
    function validInvite(gid, code) {
      let invite = get(invitePath(code)).data;
      return exists(invitePath(code)) && invite.groupId == gid && invite.active == true
        && (invite.get('expiresAt', null) == null || request.time < invite.expiresAt)
        && groupData(gid).inviteCode == code && groupData(gid).inviteActive == true;
    }
    // Names every phone can show, and a push title FCM takes.
    function groupName(value) { return value is string && value.size() > 0 && value.size() <= 100; }
    function memberName(value) { return value is string && value.size() > 0 && value.size() <= 60; }
    // H2: every document names its fields and caps its text, so nobody fills one up to Firestore's 1 MiB.
    function textUpTo(value, max) { return value is string && value.size() <= max; }
    function textOrNull(value, max) { return value == null || textUpTo(value, max); }
    function shortId(value) { return textUpTo(value, 128); }
    // M3: money is whole minor units, never past 10^13, so no sum of shares can wrap a 64-bit total.
    function money(value) { return value is int && value >= 0 && value <= 10000000000000; }
    function splitModeOk(value) { return value in ['Equally', 'Exact', 'Percent', 'Shares']; }
    function currencyCode(value) { return value is string && value.matches('[A-Z]{3}'); }
    // No rate, or one above zero with a scale every build can read.
    function rateOk(data) {
      return (data.get('rateUnscaled', null) == null && data.get('rateScale', null) == null)
        || (data.rateUnscaled is int && data.rateUnscaled > 0
          && data.rateScale is int && data.rateScale >= 0 && data.rateScale <= 9);
    }

    match /groups/{gid} {
      function groupTypeOk() { return request.resource.data.type in ['Trip', 'Flat', 'Couple', 'Other']; }
      function uidsBefore() { return resource.data.memberUids; }
      function uidsAfter() { return request.resource.data.memberUids; }
      function liveNow() { return resource.data.get('deleted', false) != true; }
      // The code [uid] joined with is not the live one, so once out it cannot add itself back.
      function cannotRejoin(uid) {
        let join = /databases/$(database)/documents/groups/$(gid)/joins/$(uid);
        return request.resource.data.inviteActive != true || !exists(join)
          || get(join).data.code != request.resource.data.inviteCode;
      }

      allow get: if isMember(gid) || joined(gid);
      // A member finds their own groups again after signing in: a query on memberUids holding their uid.
      allow list: if signedIn() && request.auth.uid in resource.data.memberUids;
      // #48: a group's money is set when it is made, as an ISO code, and no update may change it.
      function groupCurrencyOk() {
        return !('currency' in request.resource.data)
          || (request.resource.data.currency is string && request.resource.data.currency.matches('[A-Z]{3}'));
      }
      // The fields SharedSync.share and its later patches write, and nothing else.
      function groupFieldsOk() {
        let group = request.resource.data;
        return group.keys().hasOnly(['name', 'type', 'icon', 'simplifyDebts', 'createdAt', 'currency', 'creatorUid',
            'memberUids', 'inviteCode', 'inviteActive', 'deleted', 'deletedAt'])
          && textUpTo(group.get('icon', ''), 64) && group.get('simplifyDebts', true) is bool
          && group.get('createdAt', 0) is int && textOrNull(group.get('inviteCode', null), 64)
          && group.get('inviteActive', false) is bool && group.get('deleted', false) is bool
          && (group.get('deletedAt', null) == null || group.deletedAt is timestamp);
      }
      // H3: a delete carries the server's own time, so the clean-up can tell when 30 days have passed.
      function deletedNow() {
        return !changed().hasAny(['deletedAt'])
          || (request.resource.data.deletedAt == request.time && request.resource.data.deleted == true);
      }
      function leavesAlone() { return uidsBefore().hasAll(uidsAfter()) && uidsBefore().removeAll(uidsAfter()) == [request.auth.uid]; }
      allow create: if signedIn() && groupFieldsOk()
        && request.resource.data.creatorUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid]
        && groupName(request.resource.data.name) && groupTypeOk() && groupCurrencyOk();
      allow update: if
        // Any member edits the name, icon or the Simplify debts switch, while the group is live.
        (isMember(gid) && live(gid) && onlyChanged(['name', 'icon', 'type', 'simplifyDebts']) && groupFieldsOk()
            && (!changed().hasAny(['name']) || groupName(request.resource.data.name))
            && (!changed().hasAny(['type']) || groupTypeOk()))
        // Only the creator changes or switches off the invite (#190), or deletes the group for everyone.
        || (isCreator(gid) && onlyChanged(['inviteCode', 'inviteActive', 'deleted', 'deletedAt']) && groupFieldsOk() && deletedNow())
        // Someone who joined with a live code adds themselves, and removes nobody, while the group is live.
        || (joinedAfter(gid) && liveNow() && onlyChanged(['memberUids']) && uidsAfter().size() <= 100
            && uidsAfter().hasAll(uidsBefore()) && uidsAfter().removeAll(uidsBefore()) == [request.auth.uid])
        // A member leaves, when they delete their account (#187), and adds nobody.
        || (isMember(gid) && onlyChanged(['memberUids']) && leavesAlone())
        // L2: a creator deleting their account switches the invite off as they go; nobody else could.
        || (isCreator(gid) && isMember(gid) && onlyChanged(['memberUids', 'inviteActive'])
            && request.resource.data.inviteActive == false && leavesAlone())
        // The creator takes one other account out, with the name it claimed: it can no longer read or write here.
        || (isCreator(gid) && onlyChanged(['memberUids'])
            && uidsBefore().hasAll(uidsAfter()) && uidsBefore().removeAll(uidsAfter()).size() == 1
            && request.auth.uid in uidsAfter() && cannotRejoin(uidsBefore().removeAll(uidsAfter())[0]));
      allow delete: if false;

      match /members/{mid} {
        // #199: a PromptPay ID only ever belongs to the account that claimed the name. Nobody plants
        // one on a name someone else will claim, and letting a claim go clears it.
        function noPromptPay() { return !('promptPay' in request.resource.data) || request.resource.data.promptPay == null; }
        function ownPromptPay() { return noPromptPay() || request.resource.data.claimedByUid == request.auth.uid; }
        // A phone number, a national or tax ID, or an e-wallet ID, digits only, as the app saves it.
        function validPromptPay() {
          return noPromptPay() || (request.resource.data.promptPay is string
            && request.resource.data.promptPay.matches('^(0[0-9]{9}|[0-9]{13}|[0-9]{15})$'));
        }
        // H1: a name is claimed only in the commit that brings its account into the group, so an account
        // already in keeps the one it came with. Leaving lets it go, and the next join may pick another.
        function joiningNow() {
          return !(request.auth.uid in groupData(gid).memberUids)
            && request.auth.uid in getAfter(groupPath(gid)).data.memberUids;
        }
        function memberFieldsOk() {
          return request.resource.data.keys().hasOnly(['name', 'claimedByUid', 'archived', 'createdAt', 'promptPay'])
            && request.resource.data.get('archived', false) is bool && request.resource.data.get('createdAt', 0) is int;
        }
        // H3: a group deleted for everyone shows nothing but its own document, which tells phones it went.
        allow read: if (isMember(gid) || joined(gid)) && live(gid);
        // A member adds a name; the creator adds their own, already claimed, when sharing (#190);
        // someone joining adds themselves ("I'm not on the list").
        allow create: if ownPromptPay() && validPromptPay() && live(gid) && memberName(request.resource.data.name)
          && memberFieldsOk() && (
          (isMember(gid) && request.resource.data.claimedByUid == null)
          || (isCreator(gid) && request.resource.data.claimedByUid == request.auth.uid)
          || (joinedAfter(gid) && (request.resource.data.claimedByUid == null
              || (request.resource.data.claimedByUid == request.auth.uid && joiningNow()))));
        allow update: if
          // M2: a claimed name is renamed by the account that holds it or by the creator; a free one by
          // any member. A patch that sends the name as it is changes nothing and passes.
          (isMember(gid) && live(gid) && onlyChanged(['name']) && memberName(request.resource.data.name)
              && (!changed().hasAny(['name']) || resource.data.get('claimedByUid', null) == null
                || resource.data.get('claimedByUid', null) == request.auth.uid || isCreator(gid)))
          // Only the creator removes a member, by archiving the name (#190), or puts one back. A claimed
          // name goes only with its account, below.
          || (isCreator(gid) && onlyChanged(['archived']) && request.resource.data.archived is bool
              && (request.resource.data.archived != true || resource.data.claimedByUid == null))
          // Removing a claimed name lets its claim and PromptPay ID go, in the commit that takes its
          // account out of the group: a removed name never keeps its access.
          || (isCreator(gid) && onlyChanged(['archived', 'claimedByUid', 'promptPay']) && noPromptPay()
              && request.resource.data.archived == true && request.resource.data.claimedByUid == null
              && resource.data.claimedByUid != request.auth.uid
              && !(resource.data.claimedByUid in getAfter(groupPath(gid)).data.memberUids))
          // Claiming a name nobody holds, once joined.
          || (joinedAfter(gid) && joiningNow() && onlyChanged(['claimedByUid']) && resource.data.archived != true && noPromptPay()
              && resource.data.claimedByUid == null && request.resource.data.claimedByUid == request.auth.uid)
          // Your own PromptPay ID, on the name you claimed (#199).
          || (isMember(gid) && resource.data.claimedByUid == request.auth.uid && onlyChanged(['promptPay']) && validPromptPay())
          // Letting your own claim go (#187).
          || (isMember(gid) && onlyChanged(['claimedByUid', 'promptPay']) && noPromptPay()
              && resource.data.claimedByUid == request.auth.uid && request.resource.data.claimedByUid == null)
          // H3: deleting the group for everyone clears every PromptPay ID, in the same commit.
          || (isCreator(gid) && onlyChanged(['promptPay']) && noPromptPay()
              && getAfter(groupPath(gid)).data.get('deleted', false) == true);
        allow delete: if false;
      }

      // syncedAt must be the server's own stamp, so no phone can backdate an entry out of another
      // member's pull or push one into the future, where every pull would fetch it again.
      match /entries/{eid} {
        function entry() { return request.resource.data; }
        // An entry is signed by the name its writer claimed, never by someone else's. Only the entry a
        // repeat adds itself carries no name.
        function signedByWriter() {
          let author = entry().get('authorMemberId', null);
          return (author == null && entry().kind == 'version' && entry().get('cause', null) == 'repeat')
            || (author != null && exists(memberPath(gid, author)) && get(memberPath(gid, author)).data.claimedByUid == request.auth.uid);
        }
        // #48: the amount in the group's own money. A baht group writes amountSatang, which every
        // build reads; any other group writes amountGroup, so older builds skip it rather than misread
        // it. The key is the group's, never the writer's choice: a build from before #48 that still
        // writes amountSatang into a kyat group is refused, so its baht never reads as kyat.
        function amountKey() { return groupData(gid).get('currency', 'THB') == 'THB' ? 'amountSatang' : 'amountGroup'; }
        function otherKey() { return amountKey() == 'amountSatang' ? 'amountGroup' : 'amountSatang'; }
        function groupAmount() { return entry().get(amountKey(), null); }
        function keyedToGroup() { return amountKey() in entry() && !(otherKey() in entry()); }
        // Values every build can read, so no member can store one that stops the others' apps.
        function validVersion() {
          return entry().keys().hasOnly(['kind', 'authorUid', 'createdAt', 'syncedAt', 'authorMemberId', 'expenseId',
              'version', 'description', 'occurredAt', 'categoryId', 'subCategoryId', 'note', 'currency', 'amountMinor',
              'rateUnscaled', 'rateScale', 'amountSatang', 'amountGroup', 'payerMemberId', 'splitMode', 'removed',
              'cause', 'shares'])
            && shortId(entry().expenseId) && entry().version is int && entry().occurredAt is int
            && textUpTo(entry().get('description', ''), 500) && textOrNull(entry().get('note', null), 2000)
            && textOrNull(entry().get('categoryId', null), 128) && textOrNull(entry().get('subCategoryId', null), 128)
            && currencyCode(entry().currency) && shortId(entry().payerMemberId)
            && entry().get('removed', false) is bool && textOrNull(entry().get('cause', null), 32)
            && splitModeOk(entry().splitMode)
            && money(entry().amountMinor) && keyedToGroup() && money(groupAmount())
            && entry().shares is list && entry().shares.size() > 0 && entry().shares.size() <= 50
            && rateOk(entry());
        }
        function validPayment() {
          return entry().keys().hasOnly(['kind', 'authorUid', 'createdAt', 'syncedAt', 'authorMemberId', 'fromMemberId',
              'toMemberId', 'amountSatang', 'amountGroup', 'method', 'occurredAt'])
            && entry().method in ['BankTransfer', 'Cash', 'PromptPay', 'OtherApp']
            && keyedToGroup() && money(groupAmount()) && groupAmount() > 0
            && shortId(entry().fromMemberId) && shortId(entry().toMemberId) && entry().occurredAt is int
            && entry().fromMemberId != entry().toMemberId;
        }
        // #218: a removal names the payment it takes out or puts back.
        function validRemoval() {
          return entry().keys().hasOnly(['kind', 'authorUid', 'createdAt', 'syncedAt', 'authorMemberId', 'paymentId', 'removed'])
            && shortId(entry().paymentId) && entry().get('removed', false) is bool;
        }
        allow read: if isMember(gid) && live(gid);
        allow create: if isMember(gid) && live(gid) && entry().authorUid == request.auth.uid
          && signedByWriter()
          && entry().kind in ['version', 'payment', 'paymentRemoval']
          && (entry().kind != 'version' || validVersion())
          && (entry().kind != 'payment' || validPayment())
          && (entry().kind != 'paymentRemoval' || validRemoval())
          && entry().syncedAt == request.time
          // The writing phone's own clock, never more than a day ahead of the server's: a row dated
          // in the future would sit above every later one. A day covers a phone set to the wrong zone.
          && entry().createdAt is int
          && entry().createdAt <= request.time.toMillis() + 86400000;
        allow update, delete: if false;
      }

      // #182: any member sets up, changes or stops a repeat; none is ever deleted.
      match /repeats/{rid} {
        // The template as every build sends it, with an expense's limits on its money and its text.
        function validRepeat() {
          let repeat = request.resource.data;
          return repeat.keys().hasOnly(['authorUid', 'createdAt', 'syncedAt', 'kind', 'frequency', 'start', 'endKind',
              'endDate', 'endTimes', 'active', 'description', 'categoryId', 'currency', 'amountMinor', 'rateUnscaled',
              'rateScale', 'payerMemberId', 'splitMode', 'weights'])
            && repeat.createdAt is int && textUpTo(repeat.kind, 32) && textUpTo(repeat.frequency, 32)
            && textUpTo(repeat.start, 32) && textUpTo(repeat.get('endKind', ''), 32)
            && textOrNull(repeat.get('endDate', null), 32)
            && (repeat.get('endTimes', null) == null || repeat.endTimes is int) && repeat.active is bool
            && textUpTo(repeat.get('description', ''), 500) && textOrNull(repeat.get('categoryId', null), 128)
            && currencyCode(repeat.currency) && money(repeat.amountMinor) && rateOk(repeat)
            && shortId(repeat.payerMemberId) && splitModeOk(repeat.splitMode) && textUpTo(repeat.get('weights', ''), 8000);
        }
        allow read: if isMember(gid) && live(gid);
        allow create: if isMember(gid) && live(gid) && request.resource.data.authorUid == request.auth.uid
          && validRepeat()
          && request.resource.data.syncedAt == request.time;
        // Whoever changes it signs the change, and the first creation time stays put.
        allow update: if isMember(gid) && live(gid) && request.resource.data.authorUid == request.auth.uid
          && validRepeat()
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.syncedAt == request.time;
        allow delete: if false;
      }

      match /joins/{uid} {
        allow get: if signedIn() && (uid == request.auth.uid || isMember(gid));
        allow list: if isMember(gid);
        allow create, update: if signedIn() && uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['code', 'at']) && textUpTo(request.resource.data.code, 64)
          && request.resource.data.get('at', 0) is int && validInvite(gid, request.resource.data.code);
        allow delete: if false;
      }
    }

    // One phone at a time: the account's newest sign-in, as auth_time seconds. Each phone reads it
    // on sync and signs out when another phone's is newer. Removed when the account is deleted.
    // Never later than this token's own sign-in, so no session can sign out every phone to come.
    match /sessions/{uid} {
      allow get, delete: if signedIn() && uid == request.auth.uid;
      allow create, update: if signedIn() && uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['signedInAt']) && request.resource.data.signedInAt is int
        && request.resource.data.signedInAt <= request.auth.token.auth_time;
      allow list: if false;
    }

    // Push: one document per phone, keyed by its Firebase installation ID. A phone keeps only its own account's
    // documents; the Worker reads them all with the service account, which bypasses these rules.
    match /devices/{token} {
      function validDevice() {
        return request.resource.data.keys().hasOnly(['uid', 'platform', 'language', 'updatedAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.platform in ['android', 'ios']
          && request.resource.data.language in ['en', 'my', 'th']
          && request.resource.data.updatedAt is int;
      }
      allow get, list, delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn() && validDevice();
      // Nobody takes over another account's phone, and with it that account's pushes.
      allow update: if signedIn() && resource.data.uid == request.auth.uid && validDevice();
    }

    // One document per live code, so a code can be looked up without listing anything.
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if isCreator(request.resource.data.groupId) && request.resource.data.creatorUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['groupId', 'groupName', 'active', 'creatorUid', 'expiresAt']) && code.size() <= 64
        && textUpTo(request.resource.data.get('groupName', ''), 100) && request.resource.data.get('active', false) is bool
        && (request.resource.data.get('expiresAt', null) == null || request.resource.data.expiresAt is timestamp);
      // Only switching it off: the group it points at never changes.
      allow update: if isCreator(resource.data.groupId) && onlyChanged(['active']) && request.resource.data.active is bool;
      allow delete: if false;
    }
  }
}
